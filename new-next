#!/usr/bin/env bash
#
# new-next — scaffold a new Next.js + Payload project from template-next
#
# Usage:  new-next <project-name>
#
# Requires: git, pnpm, docker (with colima running), openssl
#
set -euo pipefail

# ─── Configuration ────────────────────────────────────────────────
SITES_DIR="$HOME/Sites"
GITHUB_USER="baalej"
TEMPLATE_REPO="template-next"
NODE_VERSION="22"
# ──────────────────────────────────────────────────────────────────

TEMPLATE_URL="https://github.com/$GITHUB_USER/$TEMPLATE_REPO"

red()   { printf '\033[0;31m%s\033[0m\n' "$*"; }
green() { printf '\033[0;32m%s\033[0m\n' "$*"; }
info()  { printf '\033[0;36m→\033[0m %s\n' "$*"; }
warn()  { printf '\033[0;33m!\033[0m %s\n' "$*"; }

NAME="${1:-}"
if [[ -z "$NAME" ]]; then
  red "Usage: new-next <project-name>"
  exit 1
fi

if [[ ! "$NAME" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  red "Invalid name. Use lowercase letters, numbers and hyphens only."
  exit 1
fi

DEST="$SITES_DIR/$NAME"
[[ -e "$DEST" ]] && { red "Already exists: $DEST"; exit 1; }

for cmd in git pnpm openssl; do
  command -v "$cmd" >/dev/null || { red "Missing '$cmd' in PATH"; exit 1; }
done

# ─── Clone template ───────────────────────────────────────────────
info "Cloning $TEMPLATE_REPO"
git clone --depth 1 "$TEMPLATE_URL" "$DEST"
cd "$DEST"
rm -rf .git

# ─── Node version ─────────────────────────────────────────────────
if command -v mise >/dev/null; then
  info "Pinning Node $NODE_VERSION with mise"
  mise use "node@$NODE_VERSION" >/dev/null 2>&1 || true
fi

# ─── Environment ──────────────────────────────────────────────────
info "Generating .env"

DB_NAME="${NAME//-/_}"
DB_USER="$DB_NAME"
DB_PASS="$(openssl rand -hex 16)"
# Random port so multiple projects can run side by side
DB_PORT="$(( 5433 + RANDOM % 500 ))"

cat > .env <<ENVEOF
# Generated by new-next on $(date +%Y-%m-%d)

POSTGRES_DB=$DB_NAME
POSTGRES_USER=$DB_USER
POSTGRES_PASSWORD=$DB_PASS
POSTGRES_PORT=$DB_PORT

DATABASE_URI=postgres://$DB_USER:$DB_PASS@localhost:$DB_PORT/$DB_NAME

PAYLOAD_SECRET=$(openssl rand -hex 32)

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

DOMAIN=
ENVEOF

# ─── Project name in package.json ─────────────────────────────────
if [[ -f package.json ]]; then
  info "Setting project name"
  node -e "
    const fs = require('fs');
    const p = JSON.parse(fs.readFileSync('package.json', 'utf8'));
    p.name = '$NAME';
    fs.writeFileSync('package.json', JSON.stringify(p, null, 2) + '\n');
  " 2>/dev/null || warn "Could not update package.json name"
fi

# ─── Dependencies ─────────────────────────────────────────────────
info "Installing dependencies"
pnpm install

# ─── Database ─────────────────────────────────────────────────────
if docker info >/dev/null 2>&1; then
  info "Starting Postgres on port $DB_PORT"
  docker compose -f compose.dev.yml up -d

  info "Waiting for the database"
  for i in {1..30}; do
    if docker compose -f compose.dev.yml exec -T postgres \
         pg_isready -U "$DB_USER" >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
else
  warn "Docker is not running. Start it and then:"
  warn "  colima start && docker compose -f compose.dev.yml up -d"
fi

# ─── Git ──────────────────────────────────────────────────────────
info "Initializing repository"
git init -q
git add -A
git commit -qm "init: scaffolded from $TEMPLATE_REPO"

# ─── Done ─────────────────────────────────────────────────────────
echo
green "✓ $NAME created"
echo "  Path:     $DEST"
echo "  URL:      http://localhost:3000"
echo "  Postgres: localhost:$DB_PORT (db: $DB_NAME)"
echo
echo "  Next:"
echo "    cd $DEST"
echo "    pnpm payload migrate:create initial"
echo "    pnpm dev"

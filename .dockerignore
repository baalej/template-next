# Keeps the build context small and free of secrets. node_modules is
# installed inside the image; a host copy would also be the wrong platform.
.git
node_modules
.next
media

.env*
!.env.example

# Not needed to build or run the app
Caddyfile
docker-compose*.yml
README.md
AGENTS.md
CLAUDE.md
.claude
.github
.vscode

# Tests and their configs travel together: the configs import from tests/, and
# `next build` typechecks every file it's given.
tests
playwright.config.ts
vitest.config.mts
vitest.setup.ts
test-results
playwright-report
coverage

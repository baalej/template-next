# Production values for docker-compose.prod.yml, on the VPS:
#   cp .env.example .env    then fill in every value
#
# Local development doesn't use this file: new-next writes its own .env.

POSTGRES_USER=payload
POSTGRES_PASSWORD=
POSTGRES_DB=

# Host is the Compose service name; the port is Postgres's inside the network.
DATABASE_URL=postgres://payload:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>

# openssl rand -hex 32
PAYLOAD_SECRET=

# Inlined into the build, so changing it means rebuilding (--build).
NEXT_PUBLIC_SERVER_URL=https://example.com

# GA4 measurement ID (G-XXXXXXXXXX). Leave empty to ship without analytics or a
# cookie banner. Also inlined into the build.
NEXT_PUBLIC_GA_ID=

# Caddy requests the certificate for this domain and redirects www to it.
SITE_DOMAIN=example.com
